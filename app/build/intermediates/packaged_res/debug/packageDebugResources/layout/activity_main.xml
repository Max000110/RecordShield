<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ RecordShield"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vivo V40 • Call Recording UI Protection v2.1.1"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Overall Status -->
        <TextView
            android:id="@+id/tvOverallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 Action Required"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- SECTION: Shield Control Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SHIELD CONTROL &amp; RECOVERY"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enable Protection"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShieldEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginVertical="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Debug Mode (show bounds)"
                            android:textColor="@color/text_primary" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Shows a red tint over the shielded area"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDebugBounds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFailureCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consecutive Kills: 0 / 5"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnOpenDiagnostics"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="OEM Assistant"
                        android:backgroundTint="@color/accent_blue"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnTriggerFullRecovery"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Force Recovery"
                        android:backgroundTint="@color/accent_orange" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStartService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Start Protection Service"
                    android:backgroundTint="@color/accent_blue" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: Permissions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERMISSIONS"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <!-- Overlay permission row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Overlay (Draw Over Apps)" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvOverlayStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—" android:textSize="13sp"/>
                </LinearLayout>

                <Button android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Grant Overlay Permission"
                    android:backgroundTint="@color/accent_orange"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>

                <!-- Accessibility row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Accessibility Service" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvAccessibilityStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—" android:textSize="13sp"/>
                </LinearLayout>

                <Button android:id="@+id/btnOpenAccessibility"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Enable Accessibility Service"
                    android:backgroundTint="@color/accent_orange"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: Telemetry Grid Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SURVIVABILITY TELEMETRY"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <!-- Row 1: Restarts & Crashes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restarts" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvRestartCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crashes" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvCrashCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Kills & Recoveries -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kills" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvKillCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full Recoveries" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvRecoveryCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Boots" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvBootCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: Runtime Status -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RUNTIME STATUS"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <TextView android:id="@+id/tvCallStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:layout_marginBottom="6dp" android:text="📵 No active call"/>

                <TextView android:id="@+id/tvShieldStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="14sp" android:layout_marginBottom="6dp" android:text="⚫ Shield OFF"/>

                <TextView android:id="@+id/tvNodeStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp" android:text="❓ Record node not found"/>

                <TextView android:id="@+id/tvCurrentBounds" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"
                    android:text="Bounds: —"/>

                <TextView android:id="@+id/tvResourceId" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"
                    android:text="Resource-ID: —"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="In-call package:" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <TextView android:id="@+id/tvIncallPackage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_primary"
                    android:textSize="12sp" android:fontFamily="monospace" android:text="com.android.incallui"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <Button android:id="@+id/btnTestDetection"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Test Detection" android:backgroundTint="@color/accent_blue"
                        android:layout_marginEnd="8dp"/>
                    <Button android:id="@+id/btnRefreshLogs"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Refresh Logs" android:backgroundTint="@color/card_bg_elevated"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: Logs -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RECENT LOGS"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@color/log_bg"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/tvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="@color/log_text"
                        android:text="No logs yet..." />
                </ScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vivo Notes Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card_warning_bg"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⚠️ VIVO V40 DEVICE NOTES"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/text_warning" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text_warning" android:textSize="12sp"
                    android:text="For RecordShield to survive during calls:\n\n• Settings → Apps → RecordShield → Battery → No restrictions\n\n• Settings → Apps → RecordShield → Auto-start → ON\n\n• Settings → Accessibility → RecordShield → ON"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
